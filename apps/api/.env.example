# VITALIA PRO — Backend environment variables
VITALIA_ENV=development
SECRET_KEY=cambia-esta-clave-por-un-secreto-largo-y-aleatorio

# Base de datos: SQLite para desarrollo local (sin Docker) u PostgreSQL en producción.
DATABASE_URL=sqlite+aiosqlite:///./vitalia.db
# DATABASE_URL=postgresql+asyncpg://vitalia:vitalia@db:5432/vitalia

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Clave Fernet (opcional): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Orígenes permitidos (web en local + GitHub Pages)
CORS_ORIGINS=http://localhost:3003,http://localhost:3000,https://eduerking-crypto.github.io

OPENAI_API_KEY=
SENTRY_DSN=
