# ── NextAuth ─────────────────────────────────────────────
# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET=cambia-esta-clave-por-un-secreto-largo
# URL pública donde corre la web (en local, el puerto que uses)
NEXTAUTH_URL=http://localhost:3003
AUTH_TRUST_HOST=true

# ── API ──────────────────────────────────────────────────
# En modo demo el frontend no llama a la API y usa datos locales.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
