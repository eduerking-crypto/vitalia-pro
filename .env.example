# VITALIA PRO — Variables de entorno (raíz, para docker compose)
# Copia a .env y ajusta los valores en producción.

# ── Base de datos ────────────────────────────────────────────
POSTGRES_USER=vitalia
POSTGRES_PASSWORD=vitalia
POSTGRES_DB=vitalia

# ── API (FastAPI) ────────────────────────────────────────────
SECRET_KEY=cambia-esta-clave-por-un-secreto-largo-y-aleatorio
DATABASE_URL=postgresql+asyncpg://vitalia:vitalia@db:5432/vitalia
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
# Clave Fernet (base64 de 32 bytes): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:3000
# Opcional: asistente IA con LangChain
OPENAI_API_KEY=
SENTRY_DSN=

# ── Web (Next.js) ────────────────────────────────────────────
PUBLIC_API_URL=http://localhost:8000
PUBLIC_WEB_URL=http://localhost:3000
NEXTAUTH_SECRET=cambia-esta-clave-tambien
NEXTAUTH_URL=http://localhost:3000
